# Limburg OV Monitor Configuration

# NS Reisinformatie API Key (from https://apiportal.ns.nl/)
NS_API_KEY=

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ElevenLabs API key
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_ENABLED=false

# Local Ollama Host & Model
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Scheduling Configuration
# Comma-separated HH:MM times in Europe/Amsterdam timezone
SCHEDULE_TIMES=06:30,16:30
TIMEZONE=Europe/Amsterdam

# Language for generated Telegram messages: 'nl' (Dutch) or 'en' (English)
LANGUAGE=en

# Target Regions & Stations Configuration
# Monitored regions (set to 'Nederland' or leave empty for nationwide monitoring;
# or specify individual regions/provinces, e.g. 'Utrecht,Noord-Holland' or 'Limburg')
TARGET_REGIONS=

# Target station codes for NS API filtering (comma-separated uppercase codes; leave empty for nationwide)
TARGET_STATION_CODES=

# Target keywords, routes, and place names (comma-separated lowercase; leave empty for nationwide)
TARGET_KEYWORDS=

